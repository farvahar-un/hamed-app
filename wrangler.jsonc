{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hamed-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2d346077-7fa3-46ad-8cf1-24e89f794276","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ff23ae056c7a46de91186e12cea3784a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
